# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV=development

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/provider_hub?schema=public

# ==============================================================================
# LOGGING
# ==============================================================================
# LOG_LEVEL: error | warn | info | debug | verbose
LOG_LEVEL=info
# LOG_FORMAT: pretty (dev, có màu) | json (prod, cho ELK/Loki/CloudWatch)
LOG_FORMAT=pretty

# ==============================================================================
# AUTHENTICATION & JWT (Internal System)
# ==============================================================================
JWT_SECRET=super-secret-jwt-key-provider-integration-hub-change-in-production
JWT_EXPIRES_IN=15m
JWT_EXPIRES_IN_SEC=900
REFRESH_JWT_SECRET=super-secret-refresh-jwt-key-change-in-production
REFRESH_JWT_EXPIRES_IN=7d
REFRESH_EXPIRES_IN_DAYS=7

# Initial Admin Seed (chỉ dùng khi chạy npm run db:seed:admin)
ADMIN_EMAIL=admin@pq.com
ADMIN_PASSWORD=123456

# ==============================================================================
# SUPPLIER: ANI SIM (SIM / eSIM Agency Integration)
# ==============================================================================
# Endpoint API chính thức của đối tác ANI SIM (ani_agency.pdf v3.0)
ANISIM_BASE_URL=https://ap1.anipay.vn
# API Key được cấp riêng cho Agency (Header X-API-Key)
ANISIM_API_KEY=ANI_SIM_AGENCY_API_KEY_HERE
