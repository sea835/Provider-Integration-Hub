# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/provider_hub?schema=public

# JWT cho đăng nhập admin. Sinh secret bằng: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_EXPIRES_IN_SEC=900
REFRESH_JWT_SECRET=
REFRESH_JWT_EXPIRES_IN=7d
REFRESH_EXPIRES_IN_DAYS=7

# Redis (BullMQ), dùng chung cho API và worker
REDIS_URL=redis://localhost:6379

# Khoá mã hoá secret lưu trong DB: 32 byte base64. Sinh bằng: openssl rand -base64 32
# Đổi khoá sẽ làm mọi secret đã lưu không giải mã được.
APP_ENCRYPTION_KEY=

# Chạy sau load balancer/proxy: số hop (vd 1) hoặc IP/subnet của proxy, để request.ip đúng IP client
# TRUST_PROXY=1

# Logger: error | warn | info | debug | verbose
LOG_LEVEL=info
# pretty (dev, có màu) | json (prod, cho ELK/Loki). Mặc định: json nếu NODE_ENV=production
LOG_FORMAT=pretty

# Tài khoản ADMIN đầu tiên, chỉ dùng cho lệnh `npm run db:seed:admin` (app không đọc)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!
