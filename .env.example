# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/provider_hub?schema=public

# Logger: error | warn | info | debug | verbose
LOG_LEVEL=info
# pretty (dev, có màu) | json (prod, cho ELK/Loki). Mặc định: json nếu NODE_ENV=production
LOG_FORMAT=pretty

# Tài khoản ADMIN đầu tiên, chỉ dùng cho lệnh `npm run db:seed:admin` (app không đọc)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!
