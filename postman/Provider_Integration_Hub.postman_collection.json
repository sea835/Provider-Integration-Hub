						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"role\": \"MANAGER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						},
						"description": "Cập nhật email / mật khẩu / role của người dùng."
					},
					"response": []
				},
				{
					"name": "5. Delete User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Delete returned true\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						},
						"description": "Xóa User theo id."
					},
					"response": []
				},
				{
					"name": "6. Verify User Deleted (Expect 404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 404 NotFound\", function () {",
									"    pm.response.to.have.status(404);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						},
						"description": "Kiểm tra lại xem User vừa bị xóa có trả về 404 NotFoundException hay không."
					},
					"response": []
				}
			]
		},
		{
			"name": "Authorization",
			"description": "Bộ API quản trị vai trò (Roles), danh mục quyền hạn (Permissions) và đồng bộ rules cho Frontend (CASL Dynamic Authorization).",
			"item": [
				{
					"name": "Roles",
					"description": "CRUD vai trò và gán quyền.",
					"item": [
						{
							"name": "1. Create Role",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"const randomSuffix = Math.random().toString(36).substring(2, 6).toUpperCase();",
											"pm.variables.set(\"dynamicRoleCode\", `ROLE_${Date.now()}_${randomSuffix}`);"
										],
										"type": "text/javascript"
									}
								},
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Status code is 201\", function () {",
											"    pm.response.to.have.status(201);",
											"});",
											"",
											"pm.test(\"Role created and has ID\", function () {",
											"    var jsonData = pm.response.json();",
											"    pm.expect(jsonData).to.have.property('id');",
											"    pm.expect(jsonData).to.have.property('code');",
											"    pm.collectionVariables.set(\"roleId\", jsonData.id);",
											"});"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"code\": \"{{dynamicRoleCode}}\",\n    \"name\": \"Vai trò Thử nghiệm\",\n    \"description\": \"Tạo qua Postman Collection\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/authorization/roles",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"authorization",
										"roles"
									]
								},
								"description": "Tạo vai trò mới. Mã role được tự động viết in hoa."
							},
							"response": []
						},
						{
							"name": "2. Get All Roles",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Status code is 200\", function () {",
											"    pm.response.to.have.status(200);",
											"});",
											"",
											"pm.test(\"Returns an array of roles\", function () {",
											"    var jsonData = pm.response.json();",
											"    pm.expect(Array.isArray(jsonData)).to.be.true;",
											"    pm.expect(jsonData.length).to.be.above(0);",
											"});"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/authorization/roles",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"authorization",
										"roles"
									]
								},
								"description": "Lấy danh sách tất cả các vai trò."
							},
							"response": []
