					"name": "Bước 3: Đăng Ký Gói & Tạo Đơn (Order Creation - Async Mode 2)",
					"description": "Mode 2: Tiếp nhận đơn hàng < 15ms, sinh mã transCode, chống nạp đúp và ủy quyền cho AnisimAdapter.",
					"item": [
						{
							"name": "3.1. Tạo đơn hàng mới (POST /engine/v1/orders)",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"// Tự động sinh requestId duy nhất chống trùng lặp",
											"const now = new Date();",
											"const timeStr = now.toISOString().replace(/[-:T.Z]/g, '').slice(0, 14);",
											"const rand = Math.floor(Math.random() * 1000).toString().padStart(3, '0');",
											"const newRequestId = 'TX_' + timeStr + '_' + rand;",
											"pm.environment.set('requestId', newRequestId);",
											"console.log('Generated new requestId: ' + newRequestId);"
										],
										"type": "text/javascript"
									}
								},
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Status code is 201 Created\", function () {",
											"    pm.response.to.have.status(201);",
											"});",
											"",
											"pm.test(\"Order accepted & PROCESSING\", function () {",
											"    const json = pm.response.json();",
											"    pm.expect(json.code).to.eql(0);",
											"    pm.expect(json.data.transCode).to.be.a('string');",
											"    pm.expect(json.data.status).to.eql('PROCESSING');",
											"    pm.expect(json.data.requestId).to.eql(pm.environment.get('requestId'));",
											"    ",
											"    // Lưu transCode vào environment để phục vụ các bước test tiếp theo",
											"    pm.environment.set('transCode', json.data.transCode);",
											"    if (json.data.supplierTransId) {",
											"        pm.environment.set('supplierTransId', json.data.supplierTransId);",
											"    }",
											"});"
										],
										"type": "text/javascript"
									}
								}
