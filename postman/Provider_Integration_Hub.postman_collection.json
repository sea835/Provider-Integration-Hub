	"item": [
		{
			"name": "Health",
			"description": "Health check cho Docker / Kubernetes. Public, không tính rate limit.",
			"auth": {
				"type": "noauth"
			},
			"item": [
				{
					"name": "1. Liveness",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Status is ok\", function () {",
									"    pm.expect(pm.response.json().status).to.eql(\"ok\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health/live",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health",
								"live"
							]
						},
						"description": "Tiến trình còn sống. Không kiểm tra database."
					},
					"response": []
				},
				{
					"name": "2. Readiness",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Database is up\", function () {",
									"    pm.expect(pm.response.json().checks.database.status).to.eql(\"up\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health/ready",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health",
								"ready"
							]
						},
						"description": "Sẵn sàng nhận traffic: kiểm tra kết nối database. Trả 503 nếu database không phản hồi."
					},
					"response": []
				}
			]
		},
		{
			"name": "Auth",
			"description": "Đăng ký, đăng nhập, refresh token. Chạy \"2. Login (Admin)\" trước để có token cho nhóm Users & Authorization.",
			"item": [
				{
					"name": "1. Register",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const randomStr = Math.random().toString(36).substring(2, 8);",
									"pm.variables.set(\"dynamicEmail\", `user_${Date.now()}_${randomStr}@example.com`);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Registered user has role USER\", function () {",
									"    pm.expect(pm.response.json().user.role).to.eql(\"USER\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Đăng ký tài khoản mới. Luôn nhận role USER; gửi field role sẽ bị từ chối 400.",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{dynamicEmail}}\",\n    \"password\": \"SecurePassword123!\"\n}"
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				},
				{
					"name": "2. Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has token pair\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('accessToken');",
									"    pm.expect(jsonData).to.have.property('refreshToken');",
									"",
									"    // Lưu token cho các request cần xác thực (auth của collection dùng {{accessToken}})",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập bằng tài khoản ADMIN, lưu accessToken / refreshToken vào biến collection.",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}"
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				},
				{
					"name": "3. Me",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Password is never returned\", function () {",
									"    pm.expect(pm.response.json()).to.not.have.property('password');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"me"
							]
						},
						"description": "Thông tin tài khoản đang đăng nhập."
					},
					"response": []
				},
				{
					"name": "4. Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has token pair\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('accessToken');",
									"    pm.expect(jsonData).to.have.property('refreshToken');",
									"",
									"    // Lưu token cho các request cần xác thực (auth của collection dùng {{accessToken}})",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						},
						"description": "Đổi refresh token lấy cặp token mới. Refresh token cũ bị thu hồi ngay (rotation).",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Users",
			"description": "Quản trị người dùng. Kiểm tra quyền CASL Manage UserEntity.",
			"item": [
				{
					"name": "1. Create User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const randomStr = Math.random().toString(36).substring(2, 8);",
									"pm.variables.set(\"dynamicEmail\", `user_${Date.now()}_${randomStr}@example.com`);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 or 200\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"pm.test(\"User created successfully and has ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('email');",
									"    ",
									"    // Tự động lưu userId vào collection variable cho các request kế tiếp",
									"    pm.collectionVariables.set(\"userId\", jsonData.id);",
									"    console.log(\"Saved userId: \" + jsonData.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{dynamicEmail}}\",\n    \"password\": \"SecurePassword123!\",\n    \"role\": \"USER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Tạo mới một User. Script pre-request tự sinh email ngẫu nhiên để tránh trùng unique constraint. Script test tự lưu id vào biến {{userId}}."
					},
					"response": []
				},
				{
					"name": "2. Get All Users",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is an array\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(Array.isArray(jsonData)).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Lấy danh sách tất cả người dùng trong hệ thống."
					},
					"response": []
				},
				{
					"name": "3. Get User By ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Returned user matches requested ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    var expectedId = pm.collectionVariables.get(\"userId\");",
									"    if (expectedId) {",
									"        pm.expect(jsonData.id).to.eql(expectedId);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						},
						"description": "Lấy thông tin chi tiết một User theo id (sử dụng biến {{userId}} từ bước tạo)."
					},
					"response": []
				},
				{
					"name": "4. Update User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"User role updated\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.role).to.eql(\"MANAGER\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
