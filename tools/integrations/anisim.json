{
  "vars": {},
  "secretKeys": [
    "apiKey"
  ],
  "spec": {
    "actions": [
      "ACTIVATE_SIM"
    ],
    "auth": {
      "type": "HEADER",
      "name": "X-API-Key",
      "value": "{{secrets.apiKey}}",
      "username": "",
      "password": ""
    },
    "headers": [],
    "packages": {
      "enabled": true,
      "request": {
        "method": "GET",
        "path": "/api/v1/agency/package-plans",
        "bodyType": "NONE",
        "body": [],
        "query": [
          {
            "name": "page",
            "value": "0",
            "omitIfEmpty": false
          },
          {
            "name": "limit",
            "value": "100",
            "omitIfEmpty": false
          }
        ]
      },
      "success": [
        {
          "path": "http.status",
          "operator": "IN",
          "values": [
            "2xx"
          ]
        },
        {
          "path": "body.code",
          "operator": "IN",
          "values": [
            "0"
          ]
        }
      ],
      "listPath": "data.items",
      "code": "data.items[*].id",
      "name": "data.items[*].name",
      "price": "data.items[*].price",
      "description": "data.items[*].type"
    },
    "check": {
      "enabled": false,
      "beforeSubmit": false,
      "request": {
        "method": "GET",
        "path": "",
        "query": [],
        "bodyType": "NONE",
        "body": []
      },
      "eligible": [],
      "ineligible": [],
      "reasonCode": "",
      "reasonMessage": "body.message",
      "errorCodePrefix": "ANI_"
    },
    "submit": {
      "resultMode": "POLL",
      "request": {
        "method": "POST",
        "path": "/api/v1/agency/orders",
        "query": [],
        "bodyType": "JSON",
        "body": [
          {
            "key": "requestId",
            "value": "{{order.transCode}}",
            "type": "string",
            "omitIfEmpty": false
          },
          {
            "key": "packagePlanId",
            "value": "{{order.packageCode}}",
            "type": "string",
            "omitIfEmpty": false
          },
          {
            "key": "serial",
            "value": "{{order.serial}}",
            "type": "string",
            "omitIfEmpty": true
          }
        ]
      },
      "success": [
        {
          "path": "http.status",
          "operator": "IN",
          "values": [
            "2xx"
          ]
        },
        {
          "path": "body.code",
          "operator": "IN",
          "values": [
            "0"
          ]
        },
        {
          "path": "body.data",
          "operator": "EXISTS",
          "values": []
        }
      ],
      "orderPath": "data",
      "messagePath": "body.message",
      "rules": [
        {
          "name": "Trùng requestId (HTTP 409)",
          "conditions": [
            {
              "path": "http.status",
              "operator": "IN",
              "values": [
                "409"
              ]
            }
          ],
          "outcome": "UNKNOWN",
          "errorCode": "ANI_4002"
        },
        {
          "name": "Trùng requestId (mã 4002)",
          "conditions": [
            {
              "path": "body.code",
              "operator": "IN",
              "values": [
                "4002"
              ]
            }
          ],
          "outcome": "UNKNOWN",
          "errorCode": "ANI_4002"
        },
        {
          "name": "Quá tần suất (HTTP 429)",
          "conditions": [
            {
              "path": "http.status",
              "operator": "IN",
              "values": [
                "429"
              ]
            }
          ],
          "outcome": "UNKNOWN",
          "errorCode": "ANI_RATE_LIMIT"
        },
        {
          "name": "Quá tần suất (mã 1000)",
          "conditions": [
            {
              "path": "body.code",
              "operator": "IN",
              "values": [
                "1000"
              ]
            }
          ],
          "outcome": "UNKNOWN",
          "errorCode": "ANI_RATE_LIMIT"
        },
        {
          "name": "Sai API key / IP (mã 2001, 2002)",
          "conditions": [
            {
              "path": "body.code",
              "operator": "IN",
              "values": [
                "2001",
                "2002"
              ]
            }
          ],
          "outcome": "CONFIG_ERROR",
          "errorCode": ""
        },
        {
          "name": "Sai API key / IP (HTTP 401, 403)",
          "conditions": [
            {
              "path": "http.status",
              "operator": "IN",
              "values": [
                "401",
                "403"
              ]
            }
          ],
          "outcome": "CONFIG_ERROR",
          "errorCode": ""
        },
        {
          "name": "Từ chối đơn (mã 4000, 4001, 6000)",
          "conditions": [
            {
              "path": "body.code",
              "operator": "IN",
              "values": [
                "4000",
                "4001",
                "6000"
              ]
            }
          ],
          "outcome": "REJECTED",
          "errorCode": "ANI_{{body.code}}"
        },
        {
          "name": "Từ chối đơn (HTTP 400, 404)",
          "conditions": [
            {
              "path": "http.status",
              "operator": "IN",
              "values": [
                "400",
                "404"
              ]
            }
          ],
          "outcome": "REJECTED",
          "errorCode": "ANI_{{body.code || http.status}}"
        }
      ]
    },
    "query": {
      "source": "ORDERS",
      "request": {
        "method": "GET",
        "path": "",
        "query": [],
        "bodyType": "NONE",
        "body": []
      },
      "success": [
        {
          "path": "http.status",
          "operator": "IN",
          "values": [
            "2xx"
          ]
        }
      ],
      "orderPath": "",
      "matchField": "",
      "messagePath": "body.message",
      "notFound": []
    },
    "orders": {
      "enabled": true,
      "request": {
        "method": "GET",
        "path": "/api/v1/agency/orders",
        "bodyType": "NONE",
        "body": [],
        "query": [
          {
            "name": "keyword",
            "value": "{{order.transCode}}",
            "omitIfEmpty": true
          },
          {
            "name": "page",
            "value": "0",
            "omitIfEmpty": false
          },
          {
            "name": "limit",
            "value": "50",
            "omitIfEmpty": false
          }
        ]
      },
      "success": [
        {
          "path": "http.status",
          "operator": "IN",
          "values": [
            "2xx"
          ]
        },
        {
          "path": "body.code",
          "operator": "IN",
          "values": [
            "0"
          ]
        }
      ],
      "listPath": "data.items",
      "matchBy": "SUPPLIER_ID",
      "matchField": "data.items[*].requestId",
      "createdAt": "data.items[*].createdAt"
    },
    "order": {
      "status": "data.items[*].status",
      "statusMap": [
        {
          "value": "1",
          "outcome": "PENDING",
          "errorCode": ""
        },
        {
          "value": "2",
          "outcome": "PENDING",
          "errorCode": ""
        },
        {
          "value": "3",
          "outcome": "PENDING",
          "errorCode": ""
        },
        {
          "value": "4",
          "outcome": "SUCCESS",
          "errorCode": ""
        },
        {
          "value": "5",
          "outcome": "FAILED",
          "errorCode": ""
        },
        {
          "value": "6",
          "outcome": "FAILED",
          "errorCode": "ANI_ORDER_CANCELLED"
        }
      ],
      "supplierTransId": "data.items[*].id",
      "errorCode": "data.items[*].errorCode",
      "errorCodePrefix": "ANI_",
      "errorMessage": "data.items[*].errorMessage",
      "delivery": {
        "msisdn": "data.items[*].msisdn",
        "serial": "data.items[*].serial",
        "lpa": "data.items[*].lpa",
        "qrUrl": "data.items[*].urlLpa"
      }
    },
    "test": {
      "request": {
        "method": "GET",
        "path": "/api/v1/agency/package-plans",
        "bodyType": "NONE",
        "body": [],
        "query": [
          {
            "name": "page",
            "value": "0",
            "omitIfEmpty": false
          },
          {
            "name": "limit",
            "value": "1",
            "omitIfEmpty": false
          }
        ]
      },
      "success": [
        {
          "path": "http.status",
          "operator": "IN",
          "values": [
            "2xx"
          ]
        },
        {
          "path": "body.code",
          "operator": "IN",
          "values": [
            "0"
          ]
        }
      ]
    },
    "callback": {
      "enabled": true,
      "eventId": "body.eventId || headers.x-mk-callback-id",
      "transCode": "body.data.requestId || body.requestId",
      "orderPath": "body.data",
      "accept": [
        {
          "path": "body.event || headers.x-mk-callback-event || 'ORDER_RESULT'",
          "operator": "IN",
          "values": [
            "ORDER_RESULT"
          ]
        }
      ]
    }
  }
}
