    "auth": {
      "type": "BEARER",
      "name": "",
      "value": "{{token}}",
      "username": "",
      "password": ""
    },
    "token": {
      "enabled": true,
      "request": {
        "method": "POST",
        "path": "/telco/partner/login",
        "query": [],
        "bodyType": "JSON",
        "body": [
          {
            "key": "username",
            "value": "{{vars.username}}",
            "type": "string",
            "omitIfEmpty": false
          },
          {
            "key": "password",
            "value": "{{secrets.password}}",
            "type": "string",
            "omitIfEmpty": false
          }
        ]
      },
      "success": [
        {
          "path": "http.status",
          "operator": "IN",
          "values": [
            "2xx"
          ]
        },
        {
          "path": "body.error",
          "operator": "IN",
          "values": [
            "866000000"
